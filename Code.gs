n    /** Keep the closed mobile drawer out of keyboard navigation. */\n    function syncMobileNavigation() {\n      var sidebar = document.getElementById(\"leftSidebar\");\n      var isMobile = window.matchMedia(\"(max-width: 820px)\").matches;\n      var isOpen = sidebar.classList.contains(\"open\");\n      sidebar.inert = isMobile && !isOpen;\n      sidebar.setAttribute(\"aria-hidden\", String(isMobile && !isOpen));\n      document.body.style.overflow = isMobile && isOpen ? \"hidden\" : \"\";\n    }\n\n    var QUIZ_GECIS_TIMER = null;\n\n    function quizGecisZamanlayiciTemizle() {\n      if (QUIZ_GECIS_TIMER) {\n        clearTimeout(QUIZ_GECIS_TIMER);\n        QUIZ_GECIS_TIMER = null;\n      }\n    }\n\n    function sekmeDegistir(s) {\n      quizGecisZamanlayiciTemizle();\n      AKTIF_SEKME = s;\n      mobilMenuKapat();\n      sekmeButonlariniGuncelle();\n      document.getElementById(\"sheet1View\").style.display = s === \"sheet1\" ? \"block\" : \"none\";\n      var shHavuzView = document.getElementById(\"sheetHavuzView\");\n      if (shHavuzView) shHavuzView.style.display = s === \"sheetHavuz\" ? \"block\" : \"none\";\n      document.getElementById(\"poolView\").style.display = s === \"pool\" ? \"block\" : \"none\";\n      var kpView = document.getElementById(\"knownPoolView\");\n      if (kpView) kpView.style.display = s === \"knownPool\" ? \"block\" : \"none\";\n      document.getElementById(\"flashcardView\").style.display = s === \"flashcards\" ? \"block\" : \"none\";\n      var stView = document.getElementById(\"statsView\");\n      if (stView) stView.style.display = s === \"stats\" ? \"block\" : \"none\";\n      FC_FLIPPED = false;\n      tercihleriKaydet();\n      tabloyuCiz();\n    }\n\n    function calismaModuAc(mod) {\n      quizGecisZamanlayiciTemizle();\n      AKTIF_MOD = mod || \"flashcards\";\n      AKTIF_SEKME = \"flashcards\";\n      mobilMenuKapat();\n      FC_FLIPPED = false;\n      SECENEKLER_CACHE = { key: \"\", list: [] };\n      if (mod === \"match\") {\n        MATCH_DURUM = { seciliEn: null, seciliTr: null, eslesenler: {}, trSira: [], keySet: \"\" };\n      }\n      sekmeButonlariniGuncelle();\n      document.getElementById(\"sheet1View\").style.display = \"none\";\n      var shHavuzView = document.getElementById(\"sheetHavuzView\");\n      if (shHavuzView) shHavuzView.style.display = \"none\";\n      document.getElementById(\"poolView\").style.display = \"none\";\n      var kpView = document.getElementById(\"knownPoolView\");\n      if (kpView) kpView.style.display = \"none\";\n      document.getElementById(\"flashcardView\").style.display = \"block\";\n      var stView = document.getElementById(\"statsView\");\n      if (stView) stView.style.display = \"none\";\n      tercihleriKaydet();\n      tabloyuCiz();\n      if (mod === \"listen\") {\n        setTimeout(function() {\n          var poolList = aktifHavuzuGetir();\n          var deck = fcDestesiniGetir(poolList);\n          if (deck.length) {\n            var card = deck[FC_INDEX % deck.length];\n            if (card) kelimeOku(card.kelime);\n          }\n        }, 120);\n      }\n    }\n\n    function aktifHavuzuGetir() {\n      var q = (document.getElementById(\"searchInput\").value || \"\").toLowerCase().trim();\n      var lvl = document.getElementById(\"levelFilter\").value;\n      return TUM_KELIMELER.filter(function(w){\n        if (w.durum !== \"bilmiyorum\") return false;\n        if (kelimeDortHaftaUstalaMi(w)) return false;\n        if (lvl !== \"ALL\" && w.seviye !== lvl) return false;\n        if (q && (w.kelime + \" \" + w.anlam + \" \" + w.ornek).toLowerCase().indexOf(q) === -1) return false;\n        return true;\n      }).sort(function(a, b){ return (a.seviye || \"\").localeCompare(b.seviye || \"\"); });\n    }\n\n    function fcDestesiniGetir(poolList) {\n      var sadeceBilinmeyenler = (poolList || []).filter(function(w) {\n        return w && w.durum === \"bilmiyorum\" && !kelimeDortHaftaUstalaMi(w);\n      });\n      if (!FC_SHUFFLED_KEYS || !FC_SHUFFLED_KEYS.length) return sadeceBilinmeyenler;\n      var byKey = {};\n      for (var i = 0; i < sadeceBilinmeyenler.length; i++) {\n        byKey[sadeceBilinmeyenler[i].kelime.toLowerCase()] = sadeceBilinmeyenler[i];\n      }\n      var result = [];\n      var used = {};\n      for (var j = 0; j < FC_SHUFFLED_KEYS.length; j++) {\n        var k = FC_SHUFFLED_KEYS[j];\n        if (byKey[k]) {\n          result.push(byKey[k]);\n          used[k] = true;\n        }\n      }\n      for (var m = 0; m < sadeceBilinmeyenler.length; m++) {\n        var km = sadeceBilinmeyenler[m].kelime.toLowerCase();\n        if (!used[km]) result.push(sadeceBilinmeyenler[m]);\n      }\n      return result;\n    }\n\n    function modCubuguHtml() {\n      var modes = [\n        { id: \"flashcards\", label: \"🃏 Flashcards\" },\n        { id: \"cloze\", label: \"📝 Cloze\" },\n        { id: \"quiz\", label: \"🎯 Quiz\" },\n        { id: \"confusables\", label: \"🔀 Confusables\" },\n        { id: \"listen\", label: \"🎧 Listen\" },\n        { id: \"match\", label: \"🧩 Match\" }\n      ];\n      var hs = hedefSayiAl();\n      var hb = hedefBirimAl();\n      var html = ['<div class=\"study-modes-bar\" style=\"align-items:center;\">'];\n      html.push(\n        '<button class=\"mode-btn\" onclick=\"sekmeDegistir(\\'sheet1\\')\" title=\"Return to Main Vocabulary Table (Words)\">' +\n          '📋 Words' +\n        '</button>'\n      );\n      html.push(\n        '<button class=\"mode-btn\" onclick=\"sekmeDegistir(\\'sheetHavuz\\')\" title=\"Google Sheets \\'Havuz\\' (Word Pool) Tab — Candidate words to transfer into Words\">' +\n          '📦 Pool' +\n        '</button>'\n      );\n      html.push(\n        '<button class=\"mode-btn\" onclick=\"sekmeDegistir(\\'pool\\')\" title=\"Unknown Words in Words Table\">' +\n          '📕 Unknown' +\n        '</button>'\n      );\n      html.push(\n        '<button class=\"mode-btn\" onclick=\"sekmeDegistir(\\'knownPool\\')\" title=\"