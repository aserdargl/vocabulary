ble .status-pill { color:#252525; font-size:calc(var(--fs) - 2px); font-weight:600; }\n    #sheet1View .sheet-table .status-pill { font-size:calc(var(--fs) - 2px); }\n    #sheet1View .sheet-table th:nth-child(1) { width:calc(var(--fs) * 2.2); }\n    #sheet1View .sheet-table th:nth-child(2) { width:calc(var(--fs) * 6.3); }\n    #sheet1View .sheet-table th:nth-child(3) { width:calc(var(--fs) * 3.3); }\n    #sheet1View .sheet-table th:nth-child(4) { width:calc(var(--fs) * 5.7); }\n    #sheet1View .sheet-table th:nth-child(6) { width:calc(var(--fs) * 8); }\n    #sheet1View .sheet-table th:nth-child(7) { width:calc(var(--fs) * 13); }\n    #sheet1View .sheet-table th:nth-child(9) { width:calc(var(--fs) * 8.6); }\n    @media(min-width:601px) { #sheet1View .sheet-table { width:max(100%,calc(var(--fs) * 74)); } }\n    @media(max-width:600px) { .main-content { padding-top:12px; } .page-heading h1 { font-size:21px; } .page-heading { margin-bottom:10px; } .overview-grid { gap:7px; } .overview-card { min-height:43px; padding:8px 10px; } .overview-card > strong { font-size:21px; } .practice-banner { flex-wrap:nowrap; padding:6px 9px; } .practice-banner > div { flex:1; flex-basis:auto; } .practice-start { margin-left:auto; padding:0 8px; font-size:10px; } .practice-banner p { font-size:10px; } .practice-icon { display:none; } .collection-heading { gap:8px; flex-wrap:wrap; } .collection-heading .collection-tools { margin-left:auto; } #sheet1View .sheet-table { width:calc(var(--fs) * 50); min-width:calc(var(--fs) * 50); } }\n    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none !important; animation:none !important; scroll-behavior:auto !important; } }\n  </style>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#mainContent\">Skip to vocabulary</a>\n  <header class=\"app-header\">\n    <a class=\"brand\" href=\"#\" onclick=\"sekmeDegistir('sheet1'); return false;\" aria-label=\"Vocabulary home\"><span class=\"brand-mark\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z\"/><path d=\"M8 7h8M8 11h6\"/></svg></span><span>vocabulary<span class=\"brand-dot\">.</span></span></a>\n    <div class=\"header-context\"><span>My workspace</span><span class=\"breadcrumb-separator\">/</span><span id=\"breadcrumbLabel\">Words</span></div>\n    <div class=\"header-actions\">\n      <span class=\"sync-badge\" id=\"syncBadge\" title=\"Two-way live sync with Google Sheets (Words)\">\n        <span class=\"sync-dot\" id=\"syncDot\"></span>\n        <span id=\"syncText\">Live</span>\n      </span>\n      <span class=\"language-pair\">EN <span>↔</span> TR</span>\n      <details class=\"settings-menu\" id=\"settingsMenu\">\n        <summary class=\"icon-button\" aria-label=\"Learning settings\" title=\"Learning settings\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16\"/><circle cx=\"9\" cy=\"7\" r=\"3\"/><circle cx=\"16\" cy=\"17\" r=\"3\"/></svg></summary>\n        <div class=\"settings-panel\"><strong>Learning settings</strong><p>Pronunciation</p><div class=\"settings-row\"><button class=\"spk-toggle on\" id=\"audioToggleBtn\" onclick=\"sesAcKapat()\" title=\"Audio ON: Click any word to hear pronunciation (Click to mute)\">🔊</button></div><p>Mastery goal</p><div class=\"font-ctrl\" style=\"padding:0 6px;gap:4px;background:#f0fdf4;border-color:#4ade80;\" title=\"Set the minimum number of distinct days or weeks with correct answers required to auto-master a word (Known)\">\n        <span style=\"font-size:11.5px;font-weight:800;color:#166534;\">🎯 Goal:</span>\n        <input type=\"number\" id=\"topMasteryCount\" aria-label=\"Mastery goal count\" min=\"1\" max=\"365\" value=\"5\" style=\"width:42px;height:22px;border:1.5px solid #86efac;border-radius:4px;text-align:center;font-size:11.5px;font-weight:800;color:#14532d;outline:none;background:#fff;\" onchange=\"ogrenmeHedefiDegistir(this.value, null)\">\n        <select id=\"topMasteryUnit\" aria-label=\"Mastery goal period\" style=\"height:22px;border:none;background:transparent;font-size:11.5px;font-weight:800;color:#14532d;outline:none;cursor:pointer;\" onchange=\"ogrenmeHedefiDegistir(null, this.value)\">\n          <option value=\"gun\" selected>Days</option>\n          <option value=\"hafta\">Weeks</option>\n        </select>\n      </div><hr><button class=\"btn\" style=\"background:#fff7ed;border-color:#fb923c;color:#9a3412;\" onclick=\"tumKelimeleriBilinmeyenYap(true)\" title=\"Move all words in Words back to Unknown status and reset streak progress\">↩️ Reset All</button></div>\n      </details>\n      <button class=\"mobile-menu-btn\" id=\"mobileMenuBtn\" onclick=\"mobilMenuAcKapat()\" aria-controls=\"leftSidebar\" aria-expanded=\"false\" aria-label=\"Open navigation\">☰</button>\n    </div>\n  </header>\n\n  <div class=\"sidebar-backdrop\" id=\"sidebarBackdrop\" onclick=\"mobilMenuKapat()\"></div>\n\n  <div class=\"app-body\">\n    <aside class=\"left-sidebar\" id=\"leftSidebar\" aria-label=\"Main navigation\">\n      <div class=\"sidebar-intro\">YOUR WORKSPACE</div>\n      <div class=\"sidebar-header-mobile\">\n        <span>📚 Navigation & Quizzes</span>\n        <button class=\"btn\" style=\"height:26px;padding:0 8px;\" onclick=\"mobilMenuKapat()\">✕ Close</button>\n      </div>\n\n      <div class=\"sidebar-group-title\">LIBRARY</div>\n      <button class=\"side-nav-btn active-mode\" id=\"topBtn-sheet1\" onclick=\"sekmeDegistir('sheet1')\" title=\"Main Vocabulary Table (Words)\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>All words</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-sheet1\">-</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-sheetHavuz\" onclick=\"sekmeDegistir('sheetHavuz')\" title=\"Google Sheets 'Havuz' (Word Pool) Tab — Candidate words to transfer into Words\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 10 5-10 5L2 8l10-5Zm-9 9 9 5 9-5M3 16l9 5 9-5\"/></svg>Word pool</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-sheetHavuz\">-</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-pool\" onclick=\"sekmeDegistir('pool')\" title=\"Unknown Words in Words Table\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>Still learning</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-pool\">-</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-knownPool\" onclick=\"sekmeDegistir('knownPool')\" title=\"Known Words in Words Table\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/></svg>Mastered</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-knownPool\">-</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-stats\" onclick=\"sekmeDegistir('stats')\" title=\"Mistake Statistics & Error Bars\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3v17h17M9 15v-4m5 4V7m5 8v-5\"/></svg>Statistics</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-stats\">0</span>\n      </button>\n\n      <div class=\"sidebar-group-title\" style=\"margin-top:6px;\">PRACTICE</div>\n      <button class=\"side-nav-btn\" id=\"topBtn-flashcards\" onclick=\"calismaModuAc('flashcards')\" title=\"3D Flashcards + Spaced Repetition\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"7\" y=\"5\" width=\"14\" height=\"16\" rx=\"2\"/><path d=\"M3 17V5a2 2 0 0 1 2-2h12M11 11h6m-6 4h4\"/></svg>Flashcards</span>\n        <span class=\"side-nav-badge\" id=\"navBadge-flashcards\">-</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-cloze\" onclick=\"calismaModuAc('cloze')\" title=\"Fill in the blank in Example Sentences\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 5h16M4 10h7m6 0h3M4 15h16M4 20h10m-1-10h2\"/></svg>Fill in the blank</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-quiz\" onclick=\"calismaModuAc('quiz')\" title=\"Active Recall (Turkish <-> English Quiz & Typing)\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg>Quiz</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-confusables\" onclick=\"calismaModuAc('confusables')\" title=\"Confusable / Similar Words Quiz (e.g. Ambiguous vs Ambitious)\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7h3c4 0 7 10 11 10h4m-4-4 4 4-4 4M3 17h3c1 0 2-1 3-2m6-6 2-2h4m-4-4 4 4-4 4\"/></svg>Similar words</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-listen\" onclick=\"calismaModuAc('listen')\" title=\"Listen to audio & find/type the word\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 14v-3a9 9 0 0 1 18 0v3\"/><rect x=\"3\" y=\"12\" width=\"4\" height=\"8\" rx=\"2\"/><rect x=\"17\" y=\"12\" width=\"4\" height=\"8\" rx=\"2\"/></svg>Listening</span>\n      </button>\n      <button class=\"side-nav-btn\" id=\"topBtn-match\" onclick=\"calismaModuAc('match')\" title=\"Match 5 English words with Turkish meanings\">\n        <span class=\"nav-label\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16m-4-4 4 4-4 4M20 17H4m4-4-4 4 4 4\"/></svg>Word match</span>\n      </button>\n      <div class=\"sidebar-bottom\"><div class=\"sidebar-note\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 4C9 2 3 8 6 15s15 5 14-11ZM5 21l10-11\"/></svg><strong>Keep growing.</strong><p>A few words, a little practice,<br>a world of difference.</p></div><a class=\"sheet-link\" href=\"https://docs.google.com/spreadsheets/d/1cUYfuFg7OSsWjCtLA7jiB77bGJITR6V0jF2ZUnyrXtc/edit\" target=\"_blank\" rel=\"noopener noreferrer\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg> Open Google Sheets <span>↗</span></a></div>\n    </aside>\n\n    <main class=\"main-content\" id=\"mainContent\" tabindex=\"-1\">\n      <div class=\"page-heading\"><div><div class=\"eyebrow\">A LITTLE EVERY DAY</div><h1 id=\"workspaceTitle\">My vocabulary</h1><p id=\"workspaceDescription\">A home for the words you’re learning. Make each one stick.</p></div><button class=\"btn btn-green\" id=\"addWordToggleBtn\" onclick=\"ekleBarAcKapat()\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg> Add word</button></div>\n      <section class=\"overview-grid\" aria-label=\"Learning overview\">\n        <button class=\"overview-card\" onclick=\"sekmeDegistir('sheet1')\"><span class=\"card-top\"><span>Total words</span><span class=\"stat-icon\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 3H20v19H6.5A2.5 2.5 0 0 1 4 19.5v-14A2.5 2.5 0 0 1 6.5 3Z\"/><path d=\"M8 7h8M8 11h6\"/></svg></span></span><strong id=\"stTotal\">0</strong><span class=\"stat-caption\">In your collection</span></button>\n        <button class=\"overview-card\" onclick=\"sekmeDegistir('pool')\"><span class=\"card-top\"><span>Still learning</span><span class=\"stat-icon amber\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg></span></span><strong id=\"stUnk\">0</strong><span class=\"stat-caption\">A little more practice</span></button>\n        <button class=\"overview-card\" onclick=\"sekmeDegistir('knownPool')\"><span class=\"card-top\"><span>Words mastered</span><span class=\"stat-icon green\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/></svg></span></span><strong id=\"stKnw\">0</strong><span class=\"stat-caption\">Look how far you’ve come</span></button>\n        <div class=\"overview-card progress-card\"><span class=\"card-top\"><span>Your progress</span><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 3v17h17M9 15v-4m5 4V7m5 8v-5\"/></svg></span><strong id=\"masteryPercent\">0<span>%</span></strong><div class=\"mastery-track\" role=\"progressbar\" aria-label=\"Words mastered\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\" id=\"masteryProgress\"><span id=\"masteryFill\"></span></div><span class=\"stat-caption\" id=\"masteryCaption\">Your next word is a step forward.</span></div>\n      </section>\n      <section class=\"practice-banner\" aria-label=\"Quick practice\"><span class=\"practice-icon\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"7\" y=\"5\" width=\"14\" height=\"16\" rx=\"2\"/><path d=\"M3 17V5a2 2 0 0 1 2-2h12M11 11h6m-6 4h4\"/></svg></span><div><strong>Small sessions. Lasting progress.</strong><p id=\"practiceDescription\">Review your words with a quick flashcard session.</p></div><button class=\"btn practice-start\" onclick=\"calismaModuAc('flashcards')\">Let’s practice <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button></section>\n      <section class=\"workspace-panel words-panel\" aria-labelledby=\"collectionTitle\">\n        <div class=\"collection-heading\"><div><h2 id=\"collectionTitle\">Your word collection</h2><span id=\"resultCount\" aria-live=\"polite\"></span></div><div class=\"collection-tools\"><div class=\"font-ctrl\" role=\"group\" aria-label=\"Table font size\" title=\"Table font size\"><button class=\"font-btn\" aria-label=\"Decrease table font size\" onclick=\"yaziBoyutuDegistir(-1)\">A−</button><span class=\"font-val\" id=\"fontValLabel\" aria-live=\"polite\">13px</span><button class=\"font-btn\" aria-label=\"Increase table font size\" onclick=\"yaziBoyutuDegistir(1)\">A+</button></div><span class=\"table-hint\">Click a word to hear it <svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 14v-3a9 9 0 0 1 18 0v3\"/><rect x=\"3\" y=\"12\" width=\"4\" height=\"8\" rx=\"2\"/><rect x=\"17\" y=\"12\" width=\"4\" height=\"8\" rx=\"2\"/></svg></span></div></div>\n        <div class=\"toolbar\"><label class=\"search-field\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" id=\"searchInput\" class=\"inp\" placeholder=\