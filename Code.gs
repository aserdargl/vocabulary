  var addBarEl = document.getElementById(\"addBar\");\n        if (addBarEl && p.addBarOpen) addBarEl.classList.add(\"open\");\n\n        if (p.aktifMod) AKTIF_MOD = p.aktifMod;\n        if (p.aktifSekme) AKTIF_SEKME = p.aktifSekme;\n\n        document.getElementById(\"sheet1View\").style.display = AKTIF_SEKME === \"sheet1\" ? \"block\" : \"none\";\n        var shHavuzView = document.getElementById(\"sheetHavuzView\");\n        if (shHavuzView) shHavuzView.style.display = AKTIF_SEKME === \"sheetHavuz\" ? \"block\" : \"none\";\n        document.getElementById(\"poolView\").style.display = AKTIF_SEKME === \"pool\" ? \"block\" : \"none\";\n        var kpView = document.getElementById(\"knownPoolView\");\n        if (kpView) kpView.style.display = AKTIF_SEKME === \"knownPool\" ? \"block\" : \"none\";\n        document.getElementById(\"flashcardView\").style.display = AKTIF_SEKME === \"flashcards\" ? \"block\" : \"none\";\n        var stView = document.getElementById(\"statsView\");\n        if (stView) stView.style.display = AKTIF_SEKME === \"stats\" ? \"block\" : \"none\";\n        sekmeButonlariniGuncelle();\n      } catch (e) {}\n    }\n\n    function sekmeButonlariniGuncelle() {\n      var s = AKTIF_SEKME;\n      var m = AKTIF_MOD;\n      document.getElementById(\"tabBtn-sheet1\").classList.toggle(\"active\", s === \"sheet1\");\n      var tabShHavuz = document.getElementById(\"tabBtn-sheetHavuz\");\n      if (tabShHavuz) tabShHavuz.classList.toggle(\"active\", s === \"sheetHavuz\");\n      document.getElementById(\"tabBtn-pool\").classList.toggle(\"active\", s === \"pool\");\n      var tabKnw = document.getElementById(\"tabBtn-knownPool\");\n      if (tabKnw) tabKnw.classList.toggle(\"active\", s === \"knownPool\");\n      var topS1 = document.getElementById(\"topBtn-sheet1\");\n      if (topS1) topS1.classList.toggle(\"active-mode\", s === \"sheet1\");\n      var topShHavuz = document.getElementById(\"topBtn-sheetHavuz\");\n      if (topShHavuz) topShHavuz.classLis