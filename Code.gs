  return (\n        '<div class=\"twin-compare-box\">' +\n          '<div class=\"twin-compare-title\">' +\n            '<span>' + (baslikMetni || '⚡ Confusable / Similar Words Comparison') + '</span>' +\n            '<span style=\"font-size:10.5px;font-weight:600;color:#9a3412;\">Click any word to hear its pronunciation 🔊</span>' +\n          '</div>' +\n          '<div class=\"twin-compare-grid\">' + kartlarHtml.join(\"\") + '</div>' +\n        '</div>'\n      );\n    }\n\n    function secenekleriUret(dogruCard, tumHavuz) {\n      var dogruKey = (dogruCard.kelime || \"\").toLowerCase().trim();\n      var akilliMi = (AKTIF_MOD === \"confusables\") || (window.AKILLI_BENZER_SIKLAR !== false);\n      var cacheKey = AKTIF_MOD + \":\" + (akilliMi ? \"smart:\" : \"rand:\") + dogruKey;\n\n      if (SECENEKLER_CACHE.key === cacheKey && SECENEKLER_CACHE.list && SECENEKLER_CACHE.list.length >= 2) {\n        return SECENEKLER_CACHE.list;\n      }\n\n      var secenekler = [dogruCard];\n      var kullanilan = {};\n      kullanilan[dogruKey] = true;\n\n      if (akilliMi) {\n        var benzerAdaylar = benzerKelimeleriBul(dogruCard, 5);\n        // İlk 2 en yakın ikizi doğrudan al, 3. çeldiriciyi ise en yakın 3.-5. aday arasından seç ki çeşitlilik de olsun\n        for (var b = 0; b < benzerAdaylar.length && secenekler.length < 3; b++) {\n          var bk = (benzerAdaylar[b].kelime || \"\").toLowerCase().trim();\n          if (!kullanilan[bk]) {\n            secenekler.push(benzerAdaylar[b]);\n            kullanilan[bk] = true;\n          }\n        }\n        var kalanBenzer = benzerAdaylar.slice(2);\n        if (kalanBenzer.length > 0 && secenekler.length < 4) {\n          var rIdx = Math.floor(Math.random() * kalanBenzer.length);\n          var secilenBenzer = kalanBenzer[rIdx];\n          var sbk = (secilenBenzer.kelime || \"\").toLowerCase().trim();\n          if (!kullanilan[sbk]) {\n            secenekler.push(secilenBenzer);\n            kullanilan[sbk] = true;\n       