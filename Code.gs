-badges\">' +\n            '<div class=\"fc-badge-group\">' +\n              '<span class=\"fc-lvl-badge\">' + escHtml(card.seviye) + '</span>' +\n              '<span class=\"fc-type-badge\">' + escHtml(turTemizle(card.tur)) + '</span>' +\n              '<span class=\"srs-badge\">📅 ' + srsEtiket + '</span>' +\n            '</div>' +\n            '<span style=\"font-size:11px;color:#64748b;font-weight:600;\">Audio-First Ear Training</span>' +\n          '</div>' +\n          '<div style=\"text-align:center;padding:12px 0;\">' +\n            '<button class=\"fc-btn fc-btn-known\" style=\"font-size:16px;padding:12px 26px;border-radius:999px;\" onclick=\"kelimeOku(\\'' + escJs(card.kelime) + '\\')\">🔊 Click to Listen Again</button>' +\n            '<div id=\"listenRevealWord\" style=\"margin-top:8px;font-size:13px;color:#64748b;font-weight:600;\">Listen to the pronunciation and select its meaning or spell it below:</div>' +\n          '</div>' +\n          '<div class=\"choice-grid\">' + btnHtml.join(\"\") + '</div>' +\n          '<div class=\"type-row\">' +\n            '<input type=\"text\" id=\"listenTypeInput\" class=\"type-inp\" placeholder=\"Spell the English word you heard...\" onkeydown=\"if(event.key===\\'Enter\\') listenYazKontrol(\\'' + escJs(card.kelime) + '\\', ' + card.row + ')\">' +\n            '<button class=\"fc-btn fc-btn-known\" onclick=\"listenYazKontrol(\\'' + escJs(card.kelime) + '\\', ' + card.row + ')\">Spell Check ↵</button>' +\n          '</div>' +\n          '<div id=\"listenFeedbackBox\" style=\"display:none;margin-top:12px;border:2px solid #22c55e;background:#f0fdf4;\" class=\"fc-example\" onclick=\"ornekOku(\\'' + escJs(card.ornek) + '\\', this)\" title=\"Click to listen to the example sentence\"></div>' +\n        '</div>' +\n        '<div class=\"fc-controls\">' +\n          '<button class=\"fc-btn\" onclick=\"fcDegistir(-1)\">◀ Prev</button>' +\n          '<button class=\"fc-btn\" onclick=\"fcDegistir(1)\">Skip / Next ▶</button>' +\n        '</div>';\n    }\n\n    function listenSecenekSec(btnEl, secilenKelime, dogruKelime, row) {\n      var card = TUM_KELIMELER.filter(function(w){ return w.row === row; })[0];\n      var fb = document.getElementById(\"listenFeedbackBox\");\n      if (secilenKelime.toLowerCase() === dogruKelime.toLowerCase()) {\n        quizGecisZamanlayiciTemizle();\n        btnEl.classList.add(\"correct\");\n        var rev = document.getElementById(\"listenRevealWord\");\n        if (rev && card) {\n          rev.innerHTML = \"✅ <strong style='color:#0f172a;font-size:16px;'>\" + escHtml(card.kelime) + \"</strong> — \" + escHtml(card.anlam);\n        }\n        if (fb && card && card.ornek) {\n          fb.style.display = \"block\";\n          fb.innerHTML = \"✅ <b>\" + escHtml(card.kelime) + \":</b> \" + ornekBicimlendir(card.ornek);\n        }\n        kelimeOku(dogruKelime);\n        alistirmaSonucuKaydet(dogruKelime, true, \"Listen\");\n        var mezun = card ? srsArtir(card) : false;\n        QUIZ_GECIS_TIMER = setTimeout(function() {\n          QUIZ_GECIS_TIMER = null;\n          SECENEKLER_CACHE = { key: \"\", list: [] };\n          if (!mezun) FC_INDEX++;\n          tabloyuCiz();\n          var yeniPool = aktifHavuzuGetir();\n          var yeniDeck = fcDestesiniGetir(yeniPool);\n          if (yeniDeck.length) {\n            var nextCard = yeniDeck[FC_INDEX % yeniDeck.length];\n            if (nextCard) kelimeOku(nextCard.kelime);\n          }\n        }, 3000);\n      } else {\n        btnEl.classList.add(\"wrong\");\n        alistirmaSonucuKaydet(dogruKelime, false, \"Listen\");\n        kelimeOku(dogruKelime);\n        bildirimGoster(\"❌ Listen again! (Mistake recorded)\");\n      }\n    }\n\n    function listenYazKontrol(dogru, row) {\n      var inp = document.getElementById(\"listenTypeInput\");\n      if (!inp) return;\n      var yazilan = inp.value.trim();\n      var card = TUM_KELIMELER.filter(function(w){ return w.row === row; })[0];\n      var fb = document.getElementById(\"listenFeedbackBox\");\n      if (yazilan.toLowerCase() === dogru.toLowerCase()) {\n        quizGecisZamanlayiciTemizle();\n        inp.style.borderColor = \"#16a34a\";\n        inp.style.background = \"#dcfce7\";\n        var rev = document.getElementById(\"listenRevealWord\");\n        if (rev && card) {\n          rev.innerHTML = \"✅ <strong style='color:#0f172a;font-size:16px;'>\" + escHtml(card.kelime) + \"</strong> — \" + escHtml(card.anlam);\n        }\n        if (fb && card && card.ornek) {\n          fb.style.display = \"block\";\n          fb.innerHTML = \"✅ <b>\" + escHtml(card.kelime) + \":</b> \" + ornekBicimlendir(card.ornek);\n        }\n        kelimeOku(dogru);\n        alistirmaSonucuKaydet(dogru, true, \"Listen\");\n        var mezun = card ? srsArtir(card) : false;\n        QUIZ_GECIS_TIMER = setTimeout(function() {\n          QUIZ_GECIS_TIMER = null;\n          SECENEKLER_CACHE = { key: \"\", list: [] };\n          if (!mezun) FC_INDEX++;\n          tabloyuCiz();\n          var yeniPool = aktifHavuzuGetir();\n          var yeniDeck = fcDestesiniGetir(yeniPool);\n          if (yeniDeck.length) {\n            var nextCard = yeniDeck[FC_INDEX % yeniDeck.length];\n            if (nextCard) kelimeOku(nextCard.kelime);\n          }\n        }, 3000);\n      } else {\n        inp.style.borderColor = \"#ef4444\";\n        alistirmaSonucuKaydet(dogru, false, \"Listen\");\n        kelimeOku(dogru);\n        bildirimGoster(\"❌ Hint: starts with '\" + dogru.slice(0, 2) + \"...'\");\n      }\n    }\n\n    function matchModuCiz(box, deck) {\n      var grupBoyutu = Math.min(5, deck.length);\n      var baslangic = Math.floor(FC_INDEX / 5) * 5;\n      if (baslangic >= deck.length) baslangic = 0;\n      var altListe = deck.slice(baslangic, baslangic + grupBoyutu);\n      var grupKey = altListe.map(function(w){ return w.kelime.toLowerCase(); }).join(\"|\");\n\n      if (MATCH_DURUM.keySet !== grupKey) {\n        var trIndisler = [];\n        for (var i = 0; i < altListe.length; i++) trIndisler.push(i);\n        for (var j = trIndisler.length - 1; j > 0; j--) {\n          var r = Math.floor(Math.random() * (j + 1));\n          var tmp = trIndisler[j];\n          trIndisler[j] = trIndisler[r];\n          trIndisler[r] = tmp;\n        }\n        MATCH_DURUM = {\n          seciliEn: null,\n          seciliTr: null,\n          eslesenler: {},\n          trSira: trIndisler,\n          keySet: grupKey\n        };\n      }\n\n      var enHtml = [];\n      var trHtml = [];\n      var eslesenSayisi = 0;\n\n      for (var m = 0; m < altListe.length; m++) {\n        var wEn = altListe[m];\n        var kEn = wEn.kelime.toLowerCase();\n        var isMatchedEn = !!MATCH_DURUM.eslesenler[kEn];\n        if (isMatchedEn) eslesenSayisi++;\n        var isSelEn = MATCH_DURUM.seciliEn === kEn;\n        enHtml.push(\n          '<div class=\"match-item' + (isMatchedEn ? ' matched' : '') + (isSelEn ? ' selected' : '') + '\" onclick=\"matchEnSec(\\'' + escJs(kEn) + '\\', \\'' + escJs(wEn.kelime) + '\\')\">' +\n            '<span>' + escHtml(wEn.kelime) + '</span>' +\n            '<span class=\"srs-badge\">📅 ' + srsEtiketGetir(wEn.kelime) + '</span>' +\n          '</div>'\n        );\n      }\n\n      for (var n = 0; n < MATCH_DURUM.trSira.length; n++) {\n        var idx = MATCH_DURUM.trSira[n];\n        var wTr = altListe[idx];\n        if (!wTr) continue;\n        var kTr = wTr.kelime.toLowerCase();\n        var isMatchedTr = !!MATCH_DURUM.eslesenler[kTr];\n        var isSelTr = MATCH_DURUM.seciliTr === kTr;\n        trHtml.push(\n          '<div class=\"match-item' + (isMatchedTr ? ' matched' : '') + (isSelTr ? ' selected' : '') + '\" id=\"matchTr-' + idx + '\" onclick=\"matchTrSec(\\'' + escJs(kTr) + '\\', ' + idx + ')\">' +\n            escHtml(wTr.anlam) +\n          '</div>'\n        );\n      }\n\n      var hepsiBitti = eslesenSayisi === altListe.length;\n\n      box.innerHTML =\n        modCubuguHtml() +\n        '<div class=\"fc-top\">' +\n          '<span>🧩 5-Word Quick Match — <b>Matched: ' + eslesenSayisi + ' / ' + altListe.length + '</b></span>' +\n          '<button class=\"btn\" onclick=\"matchYeniSet()\">🔄 Next Set</button>' +\n        '</div>' +\n        '<div class=\"study-box\">' +\n          '<div style=\"font-size:12px;color:#475569;font-weight:600;\">Click an English word on the left (it will also read it aloud) and match it with its Turkish meaning on the right:</div>' +\n          '<div class=\"match-grid\">' +\n            '<div class=\"match-col\">' + enHtml.join(\"\") + '</div>' +\n            '<div class=\"match-col\">' + trHtml.join(\"\") + '</div>' +\n          '</div>' +\n          (hepsiBitti\n            ? '<div style=\"text-align:center;padding:10px;background:#dcfce7;border:1px solid #86efac;border-radius:8px;color:#166534;font-weight:700;\">' +\n                '🎉 Great job! All ' + altListe.length + ' words matched! ' +\n                '<button class=\"fc-btn fc-btn-known\" style=\"margin-left:10px;\" onclick=\"matchYeniSet()\">Next 5 Words ▶</button>' +\n              '</div>'\n            : '') +\n        '</div>';\n    }\n\n    function matchEnSec(kEn, orijinalKelime) {\n      if (MATCH_DURUM.eslesenler[kEn]) return;\n      kelimeOku(orijinalKelime);\n      MATCH_DURUM.seciliEn = kEn;\n      matchKontrolEt();\n    }\n\n    function matchTrSec(kTr, idx) {\n      if (MATCH_DURUM.eslesenler[kTr]) return;\n      MATCH_DURUM.seciliTr = kTr;\n      matchKontrolEt(idx);\n    }\n\n    function matchKontrolEt(sonTrIdx) {\n      if (MATCH_DURUM.seciliEn && MATCH_DURUM.seciliTr) {\n        var en = MATCH_DURUM.seciliEn;\n        var tr = MATCH_DURUM.seciliTr;\n        var cardEn = TUM_KELIMELER.filter(function(w){ return w.kelime.toLowerCase() === en; })[0];\n        if (en === tr) {\n          MATCH_DURUM.eslesenler[en] = true;\n          MATCH_DURUM.seciliEn = null;\n          MATCH_DURUM.seciliTr = null;\n          alistirmaSonucuKaydet(cardEn ? cardEn.kelime : en, true, \"Match\");\n          if (cardEn) srsArtir(cardEn);\n          tabloyuCiz();\n        } else {\n          MATCH_DURUM.seciliEn = null;\n          MATCH_DURUM.seciliTr = null;\n          alistirmaSonucuKaydet(cardEn ? cardEn.kelime : en, false, \"Match\");\n          bildirimGoster(\"❌ Not a match! (Mistake recorded for \" + (cardEn ? cardEn.kelime : en) + \")\");\n          tabloyuCiz();\n        }\n      } else {\n        tabloyuCiz();\n      }\n    }\n\n    function matchYeniSet() {\n      FC_INDEX += 5;\n      MATCH_DURUM = { seciliEn: null, seciliTr: null, eslesenler: {}, trSira: [], keySet: \"\" };\n      tercihleriKaydet();\n      tabloyuCiz();\n    }\n\n    function fcHataIsaretle(row) {\n      var card = TUM_KELIMELER.filter(function(w){ return w.row === row; })[0];\n      if (!card) return;\n      FC_FLIPPED = false;\n      alistirmaSonucuKaydet(card.kelime, false, \"Flashcards\");\n      FC_INDEX++;\n      tercihleriKaydet();\n      tabloyuCiz();\n      bildirimGoster(\"❌ Mistake recorded: \" + card.kelime);\n    }\n\n    function fcSrsArtir(row) {\n      var card = TUM_KELIMELER.filter(function(w){ return w.row === row; })[0];\n      if (!card) return;\n      FC_FLIPPED = false;\n      alistirmaSonucuKaydet(card.kelime, true, \"Flashcards\");\n      var mezun = srsArtir(card);\n      if (!mezun) FC_INDEX++;\n      tercihleriKaydet();\n      tabloyuCiz();\n    }\n\n    function ornekBicimlendir(s) {\n      var temiz = escHtml(s || \"\");\n      return temiz.replace(/\\(([^)]+)\\)\\s*$/, '<span class=\"ex-tr\">($1)</span>');\n    }\n\n    function fcCevir() {\n      FC_FLIPPED = !FC_FLIPPED;\n      var el = document.getElementById(\"fcCardInner\");\n      if (el) el.classList.toggle(\"flipped\", FC_FLIPPED);\n    }\n\n    function fcDegistir(delta) {\n      quizGecisZamanlayiciTemizle();\n      FC_INDEX += delta;\n      FC_FLIPPED = false;\n      SECENEKLER_CACHE = { key: \"\", list: [] };\n      tercihleriKaydet();\n      tabloyuCiz();\n      if (AKTIF_MOD === \"flashcards\" || AKTIF_MOD === \"listen\") {\n        var poolList = aktifHavuzuGetir();\n        var deck = fcDestesiniGetir(poolList);\n        if (deck.length && SES_ACIK) {\n          var c = deck[FC_INDEX % deck.length];\n          if (c) kelimeOku(c.kelime);\n        }\n      }\n    }\n\n    function fcKaristir() {\n      quizGecisZamanlayiciTemizle();\n      var unk = TUM_KELIMELER.filter(function(w){ return w.durum === \"bilmiyorum\" && !kelimeDortHaftaUstalaMi(w); }).map(function(w){ return w.kelime.toLowerCase(); });\n      for (var i = unk.length - 1; i > 0; i--) {\n        var r = Math.floor(Math.random() * (i + 1));\n        var tmp = unk[i];\n        unk[i] = unk[r];\n        unk[r] = tmp;\n      }\n      FC_SHUFFLED_KEYS = unk;\n      FC_INDEX = 0;\n      FC_FLIPPED = false;\n      SECENEKLER_CACHE = { key: \"\", list: [] };\n      MATCH_DURUM = { seciliEn: null, seciliTr: null, eslesenler: {}, trSira: [], keySet: \"\" };\n      tercihleriKaydet();\n      tabloyuCiz();\n      bildirimGoster(\"🔀 Shuffled\");\n    }\n\n    function fcBiliyorumIsaretle(row) {\n      var card = TUM_KELIMELER.filter(function(w){ return w.row === row; })[0];\n      if (card) {\n        alistirmaSonucuKaydet(card.kelime, true, \"Flashcards\");\n      }\n      FC_FLIPPED = false;\n      kutucukDegisti(row, \"biliyorum\", true);\n    }\n\n    document.addEventListener(\"keydown\", function(e) {\n      if (AKTIF_SEKME !== \"flashcards\" || AKTIF_MOD !== \"flashcards\") return;\n      var tag = (e.target && e.target.tagName) ? e.target.tagName.toUpperCase() : \"\";\n      if (tag === \"INPUT\" || tag === \"SELECT\" || tag === \"TEXTAREA\") return;\n      if (e.code === \"Space\") {\n        e.preventDefault();\n        fcCevir();\n      } else if (e.code === \"ArrowRight\") {\n        e.preventDefault();\n        fcDegistir(1);\n      } else if (e.code === \"ArrowLeft\") {\n        e.preventDefault();\n        fcDegistir(-1);\n      }\n    });\n\n    function tabloyuCiz() {\n      dortHaftaHatasizKontrolEt();\n      var total = TUM_KELIMELER.length, unk = 0, knw = 0;\n      var lvlCounts = { B1: 0, B2: 0, C1: 0, C2: 0 };\n      var knownLvlCounts = { B1: 0, B2: 0, C1: 0, C2: 0 };\n      for (var i = 0; i < TUM_KELIMELER.length; i++) {\n        var w = TUM_KELIMELER[i];\n        if (w.durum === \"bilmiyorum\") {\n          unk++;\n          lvlCounts[w.seviye] = (lvlCounts[w.seviye] || 0) + 1;\n        } else if (w.durum === \"biliyorum\") {\n          knw++;\n          knownLvlCounts[w.seviye] = (knownLvlCounts[w.seviye] || 0) + 1;\n        }\n      }\n      document.getElementById(\"stTotal\").innerText = total;\n      document.getElementById(\"stUnk\").innerText = unk;\n      document.getElementById(\"stKnw\").innerText = knw;\n      updateWorkspaceOverview(total, unk, knw);\n      var fcTabBtn = document.getElementById(\"tabBtn-flashcards\");\n      if (fcTabBtn) fcTabBtn.innerText = \"🃏 Flashcards (\" + unk + \")\";\n      var nbS1 = document.getElementById(\"navBadge-sheet1\");\n      if (nbS1) nbS1.innerText = String(total);\n      var nbPool = document.getElementById(\"navBadge-pool\");\n      if (nbPool) nbPool.innerText = String(unk);\n      var nbKnw = document.getElementById(\"navBadge-knownPool\");\n      if (nbKnw) nbKnw.innerText = String(knw);\n      var nbFc = document.getElementById(\"navBadge-flashcards\");\n      if (nbFc) nbFc.innerText = String(unk);\n\n      var q = (document.getElementById(\"searchInput\").value || \"\").toLowerCase().trim();\n      var lvl = document.getElementById(\"levelFilter\").value;\n\n      var knownOrderMap = kisiselKnownSiraAl();\n      var s1List = [];\n      for (var j = 0; j < TUM_KELIMELER.length; j++) {\n        var xItem = TUM_KELIMELER[j];\n        if (lvl !== \"ALL\" && xItem.seviye !== lvl) continue;\n        if (q && (xItem.kelime + \" \" + xItem.anlam + \" \" + xItem.ornek).toLowerCase().indexOf(q) === -1) continue;\n        s1List.push(xItem);\n      }\n      s1List.sort(function(a, b) {\n        var aKnown = a.durum === \"biliyorum\" ? 1 : 0;\n        var bKnown = b.durum === \"biliyorum\" ? 1 : 0;\n        if (aKnown !== bKnown) return aKnown - bKnown;\n        if (aKnown === 1) {\n          var ak = (a.kelime || \"\").toLowerCase().trim();\n          var bk = (b.kelime || \"\").toLowerCase().trim();\n          var ao = knownOrderMap[ak] || a.row || 0;\n          var bo = knownOrderMap[bk] || b.row || 0;\n          if (ao !== bo) return ao - bo;\n        }\n        return (a.row || 0) - (b.row || 0);\n      });\n\n      var s1Rows = [];\n      for (var sIdx = 0; sIdx < s1List.length; sIdx++) {\n        var x = s1List[sIdx];\n        s1Rows.push(\n          '<tr class=\"' + (x.durum === \"biliyorum\" ? \"row-known\" : \"\") + '\">' +\n            '<td class=\"col-row\">' + (sIdx + 1) + '</td>' +\n            '<td class=\"col-date\">' + escHtml(x.tarih) + '</td>' +\n            '<td class=\"col-lvl\">' + escHtml(x.seviye) + '</td>' +\n            '<td class=\"col-type\">' + escHtml(turTemizle(x.tur)) + '</td>' +\n            '<td class=\"col-mark\">' + durumKutusuHtml(x.row, x.durum) + '</td>' +\n            '<td class=\"col-word\" onclick=\"kelimeOku(\\'' + escJs(x.kelime) + '\\', this)\">' +\n              escHtml(x.kelime) +\n              (x.ornek ? '<div class=\"word-hover-ex\">' + ornekBicimlendir(x.ornek) + '</div>' : '') +\n            '</td>' +\n            '<td class=\"col-meaning\">' + escHtml(x.anlam) + '</td>' +\n            '<td class=\"col-example\" onclick=\"ornekOku(\\'' + escJs(x.ornek) + '\\', this)\" title=\"Click to listen to the example sentence\">' + escHtml(x.ornek) + '</td>' +\n            '<td class=\"col-status\"><span class=\"status-pill ' + x.durum + '\">' + durumMetniGetir(x.durum) + '</span></td>' +\n          '</tr>'\n        );\n      }\n      document.getElementById(\"sheet1Body\").innerHTML = s1Rows.join(\"\") || '<tr><td colspan=\"9\" class=\"center\" style=\"padding:14px;\"><div class=\"e