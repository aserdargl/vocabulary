nue;\n        var k = w.kelime.toLowerCase().trim();\n        if (!k || gorulen[k]) continue;\n        gorulen[k] = true;\n        var ikizBilgi = IKIZ_SOZLUK_HARITASI[k];\n        birlesik.push({\n          row: w.row,\n          kelime: w.kelime,\n          okunus: w.okunus || (ikizBilgi ? ikizBilgi.meta.okunus : \"\"),\n          tur: w.tur || (ikizBilgi ? ikizBilgi.meta.tur : \"\"),\n          seviye: w.seviye || (ikizBilgi ? ikizBilgi.meta.seviye : \"B2\"),\n          anlam: w.anlam,\n          ornek: w.ornek || (ikizBilgi ? ikizBilgi.meta.ornek : \"\"),\n          ipucu: ikizBilgi ? ikizBilgi.meta.ipucu : \"\",\n          durum: w.durum,\n          isBuiltInTwin: false\n        });\n      }\n      return birlesik;\n    }\n\n    function benzerKelimeleriBul(dogruCard, maxAdet) {\n      if (!dogruCard || !dogruCard.kelime) return [];\n      var dogruKey = dogruCard.kelime.toLowerCase().trim();\n      var adaylar = tumAdayHavuzunuGetir(dogruKey);\n      var puanli = [];\n      for (var i = 0; i < adaylar.length; i++) {\n        var ad = adaylar[i];\n        var s = kelimeBenzerlikSkoruHesapla(dogruCard, ad);\n        puanli.push({ card: ad, skor: s });\n      }\n      puanli.sort(function(x, y) {\n        if (y.skor !== x.skor) return y.skor - x.skor;\n        return x.card.kelime.localeCompare(y.card.kelime);\n      });\n      var sonuc = [];\n      var limit = maxAdet || 3;\n      for (var k = 0; k < puanli.length && sonuc.length < limit; k++) {\n        sonuc.push(puanli[k].card);\n      }\n      return sonuc;\n    }\n\n    function kelimeTablodaVarMi(kelime) {\n      var k = (kelime || \"\").toLowerCase().trim();\n      for (var i = 0; i < TUM_KELIMELER.length; i++) {\n        if ((TUM_KELIMELER[i].kelime || \"\").toLowerCase().trim() === k) return true;\n      }\n      return false;\n    }\n\n    function ikizKelimeyiTabloyaEkle(kelime) {\n      var k = (kelime || \"\").toLowerCase().trim();\n      if (!k || kelimeTablodaVarMi(k)) {\n        bildirimGoster(\