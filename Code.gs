 j = 0; j < HAVUZ_KELIMELER.length; j++) {\n        var h = HAVUZ_KELIMELER[j];\n        var isDone = havuzKelimeAktarildiMi(h, wordsMap, yerelMap);\n        var hk = (h.kelime || \"\").toLowerCase().trim();\n        if (isDone && HAVUZ_SECILENLER[hk]) {\n          delete HAVUZ_SECILENLER[hk];\n        }\n        var lv = (h.seviye || \"B1\").toUpperCase().trim();\n        if (!lvlStats[lv]) lvlStats[lv] = { wait: 0, done: 0, total: 0 };\n        lvlStats[lv].total++;\n        if (isDone) {\n          doneCount++;\n          lvlStats[lv].done++;\n        } else {\n          waitCount++;\n          lvlStats[lv].wait++;\n        }\n      }\n\n      var kpiTot = document.getElementById(\"kpiHavuzTotal\");\n      var kpiWait = document.getElementById(\"kpiHavuzWaiting\");\n      var kpiDone = document.getElementById(\"kpiHavuzTransferred\");\n      if (kpiTot) kpiTot.innerText = \"📦 Total Pool: \" + totalCount;\n      if (kpiWait) kpiWait.innerText = \"⏳ Waiting: \" + waitCount;\n      if (kpiDone) kpiDone.innerText = \"✅ Transferred to Words: \" + doneCount;\n\n      var tabHavuzBtn = document.getElementById(\"tabBtn-sheetHavuz\");\n      if (tabHavuzBtn) {\n        tabHavuzBtn.innerText = totalCount > 0 ? (\"📦 Pool (\" + waitCount + \")\") : \"📦 Pool\";\n      }\n      var nbHavuz = document.getElementById(\"navBadge-sheetHavuz\");\n      if (nbHavuz) {\n        nbHavuz.innerText = totalCount > 0 ? String(waitCount) : \"-\";\n      }\n\n      var aktifLvl = (document.getElementById(\"levelFilter\") ? document.getElementById(\"levelFilter\").value : \"ALL\");\n      var sumLvls = [\"B1\", \"B2\", \"C1\", \"C2\"];\n      var sumRows = [];\n      sumRows.push(\n        '<tr class=\"havuz-sum-row' + (aktifLvl === \"ALL\" ? \" active-lvl\" : \"\") + '\" onclick=\"havuzSeviyeFiltrele(\\'ALL\\')\" title=\"Show all levels\">' +\n          '<td><b>All Levels (ALL)</b></td>' +\n          '<td class=\"center\" style=\"color:#92400e;font-weight:700;\">' + waitCount + '</td>' +\n 