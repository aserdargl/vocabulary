  dt.setHours(0, 0, 0, 0);\n      dt.setDate(dt.getDate() + 3 - ((dt.getDay() + 6) % 7));\n      var week1 = new Date(dt.getFullYear(), 0, 4);\n      var wNum = 1 + Math.round(((dt.getTime() - week1.getTime()) / 86400000 - 3 + ((week1.getDay() + 6) % 7)) / 7);\n      return dt.getFullYear() + \"-W\" + (wNum < 10 ? \"0\" + wNum : \"\" + wNum);\n    }\n\n    function haftalarArasiGunFarki(tarihStr) {\n      if (!tarihStr || tarihStr === \"-\") return 0;\n      var parcalar = tarihStr.toString().trim().slice(0, 10).split(\"-\");\n      if (parcalar.length !== 3) return 0;\n      var d = new Date(Number(parcalar[0]), Number(parcalar[1]) - 1, Number(parcalar[2]));\n      if (isNaN(d.getTime())) return 0;\n      var simdi = new Date();\n      return Math.floor((simdi.getTime() - d.getTime()) / 86400000);\n    }\n\n    function istatistikKaydiNormalizeEt(st) {\n      if (!st) return { cleanDays: [], cleanWeeks: [] };\n      if (!Array.isArray(st.cleanDays)) st.cleanDays = [];\n      if (!Array.isArray(st.cleanWeeks)) st.cleanWeeks = [];\n      var m = Number(st.mistakes) || 0;\n      var c = Number(st.correct) || 0;\n      if (st.cleanDays.length === 0 && m === 0 && c > 0) {\n        var lp = (st.lastPractice || \"\").toString();\n        var tarihMatch = lp.match(/(\\d{4}-\\d{2}-\\d{2})/);\n        if (tarihMatch && tarihMatch[1]) {\n          var dtStr = tarihMatch[1];\n          if (st.lastMistakeDate !== dtStr) {\n            st.cleanDays.push(dtStr);\n            var parcalar = dtStr.split(\"-\");\n            var dObj = new Date(Number(parcalar[0]), Number(parcalar[1]) - 1, Number(parcalar[2]));\n            var wKey = haftaAnahtariAl(dObj);\n            if (st.cleanWeeks.indexOf(wKey) === -1) st.cleanWeeks.push(wKey);\n          }\n        }\n      }\n      return st;\n    }\n\n    function kelimeIlerlemeSayisiAl(st) {\n      if (!st) return 0;\n      istatistikKaydiNormalizeEt(st);\n      if (hedefBirimAl() === \"hafta\") {\n        return Array.isArray(st.cleanWee