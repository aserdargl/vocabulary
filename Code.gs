TekKelimeAktar(\\'' + escJs(x.kelime) + '\\', \\'' + escJs(x.seviye) + '\\')\">➕ Transfer to Words</button>') +\n            '</td>' +\n          '</tr>'\n        );\n      }\n\n      mainBody.innerHTML = rowsHtml.join(\"\") || '<tr><td colspan=\"6\" class=\"center\" style=\"padding:16px;\">No matching words found in Pool.</td></tr>';\n      var selAllCb = document.getElementById(\"havuzSelectAllCb\");\n      if (selAllCb) selAllCb.checked = false;\n      havuzSecimButonunuGuncelle();\n    }\n\n    function turAdiFormatla(pos) {\n      var p = (pos || \"\").toString().toLowerCase().trim();\n      if (p.indexOf(\"adj\") === 0) return \"Adjective\";\n      if (p.indexOf(\"verb\") === 0) return \"Verb\";\n      if (p.indexOf(\"adv\") === 0) return \"Adverb\";\n      if (p.indexOf(\"noun\") === 0) return \"Noun\";\n      return \"Noun\";\n    }\n\n    function metinCevirEnTr(metin) {\n      if (!metin) return Promise.resolve(\"\");\n      var url = \"https://api.mymemory.translated.net/get?q=\" + encodeURIComponent(metin) + \"&langpair=en|tr\";\n      return fetch(url)\n        .then(function(r) { return r.json(); })\n        .then(function(d) {\n          if (d && d.responseData && d.responseData.translatedText) {\n            return d.responseData.translatedText.toString().trim();\n          }\n          return \"\";\n        })\n        .catch(function() { return \"\"; });\n    }\n\n    function kelimeBilgileriniZenginlestir(kelime, seviye) {\n      var temiz = (kelime || \"\").toString().trim();\n      var k = temiz.toLowerCase();\n      var today = new Date().toISOString().slice(0, 10);\n      var bazSeviye = (seviye || \"B2\").toString().trim().toUpperCase();\n\n      // 1. Önce yerleşik akademik sözlükte varsa doğrudan al\n      if (IKIZ_SOZLUK_HARITASI[k] && IKIZ_SOZLUK_HARITASI[k].meta) {\n        var m = IKIZ_SOZLUK_HARITASI[k].meta;\n        return Promise.resolve({\n          tarih: today,\n          seviye: bazSeviye || m.seviye || \"B2\",\n          tur: m.tur || \"Adjective\",\n          kelime: temiz,\n          okunus: m.okunus || \"\",\n          anlam: m.anlam || \"\",\n          ornek: m.ornek || \"\",\n          durum: \"bilmiyorum\"\n        });\n      }\n\n      // 2. Dictionary API (okunuş, tür, İngilizce örnek/tanım) + MyMemory (Türkçe anlam) paralel çek\n      var dictPromise = fetch(\"https://api.dictionaryapi.dev/api/v2/entries/en/\" + encodeURIComponent(k))\n        .then(function(r) { return r.ok ? r.json() : null; })\n        .catch(function() { return null; });\n\n      var trWordPromise = metinCevirEnTr(temiz);\n\n      return Promise.all([dictPromise, trWordPromise]).then(function(results) {\n        var dictData = results[0];\n        var trAnlam = (results[1] || \"\").trim();\n\n        var okunus = \"\";\n        var tur = \"Noun\";\n        var ornekEn = \"\";\n        var tanimEn = \"\";\n\n        if (Array.isArray(dictData) && dictData.length > 0) {\n          var entry = dictData[0];\n          if (entry.phonetic) {\n            okunus = entry.phonetic;\n          } else if (Array.isArray(entry.phonetics)) {\n            for (var p = 0; p < entry.phonetics.length; p++) {\n              if (entry.phonetics[p] && entry.phonetics[p].text) {\n                okunus = entry.phonetics[p].text;\n                break;\n              }\n            }\n          }\n          if (Array.isArray(entry.meanings) && entry.meanings.length > 0) {\n            tur = turAdiFormatla(entry.meanings[0].partOfSpeech);\n            for (var mi = 0; mi < entry.meanings.length; mi++) {\n              var mObj = entry.meanings[mi];\n              var defs = (mObj && Array.isArray(mObj.definitions)) ? mObj.definitions : [];\n              for (var di = 0; di < defs.length; di++) {\n                if (!tanimEn && defs[di].definition) tanimEn = defs[di].definition;\n                if (!ornekEn && defs[di].example) {\n                  ornekEn = defs[di].example;\n                  tur = turAdiFormatla(mObj.partOfSpeech || tur);\n                  break;\n                }\n              }\n              if (ornekEn) break;\n            }\n          }\n        }\n\n        if (!ornekEn) {\n          if (tur === \"Verb\") {\n            ornekEn = \"They decided to \" + k + \" the plan carefully.\";\n          } else if (tur === \"Adjective\") {\n            ornekEn = \"This is a very \" + k + \" situation for everyone.\";\n          } else if (tur === \"Adverb\") {\n            ornekEn = \"She handled the entire process \" + k + \".\";\n          } else {\n            ornekEn = \"The concept of \" + k + \" plays a key role here.\";\n          }\n        }\n\n        return metinCevirEnTr(ornekEn).then(function(ornekTr) {\n          var tamOrnek = ornekEn;\n          if (ornekTr && ornekTr.toLowerCase() !== ornekEn.toLowerCase()) {\n            tamOrnek = ornekEn + \" (\" + ornekTr + \")\";\n          }\n          var sonAnlam = trAnlam;\n          if (!sonAnlam || sonAnlam.toLowerCase() === k) {\n            sonAnlam = tanimEn || temiz;\n          }\n          // İlk harfi büyüt\n          sonAnlam = sonAnlam.charAt(0).toUpperCase() + sonAnlam.slice(1);\n          return {\n            tarih: today,\n            seviye: bazSeviye,\n            tur: tur,\n            kelime: temiz,\n            okunus: okunus,\n            anlam: sonAnlam,\n            ornek: tamOrnek,\n            durum: \"bilmiyorum\"\n          };\n        });\n      });\n    }\n\n    function havuzdanKelimeListesiAktar(hedefListe) {\n      if (HAVUZ_AKTARILIYOR) return;\n      var gecerli = [];\n      for (var i = 0; i < (hedefListe || []).length; i++) {\n        var it = hedefListe[i];\n        if (!it || !it.kelime) continue;\n        if (!kelimeTablodaVarMi(it.kelime)) {\n          gecerli.push(it);\n        }\n      }\n      if (gecerli.length === 0) {\n        bildirimGoster(\"ℹ️ Selected words are already in the Words table.\");\n        return;\n      }\n\n      HAVUZ_AKTARILIYOR = true;\n      havuzSecimButonunuGuncelle();\n      bildirimGoster(\"⏳ Transferring \" + gecerli.length + \" word(s) (with meaning, pronunciation & example) to Words...\");\n\n      var zincir = Promise.resolve([]);\n      for (var j = 0; j < gecerli.length; j++) {\n        (function(item) {\n          zincir = zincir.then(function(biriken) {\n            return kelimeBilgileriniZenginlestir(item.kelime, item.seviye).then(function(zengin) {\n              biriken.push(zengin);\n              return biriken;\n            });\n          });\n        })(gecerli[j]);\n      }\n\n      zincir.then(function(zenginKelimeler) {\n        var eklenenler = kisiselEklenenleriAl();\n        var aktarilanIsimler = [];\n        for (var m = 0; m < zenginKelimeler.length; m++) {\n          var zk = zenginKelimeler[m];\n          eklenenler.push(zk);\n          kisiselDurumKaydet(zk.kelime, \"bilmiyorum\");\n          var lowK = zk.kelime.toLowerCase().trim();\n          SON_YEREL_DEGISIM[lowK] = Date.now();\n          delete HAVUZ_SECILENLER[lowK];\n          aktarilanIsimler.push(zk.kelime);\n        }\n        kisiselEklenenKaydet(eklenenler);\n        havuzYerelAktarilanKaydet(aktarilanIsimler);\n\n        for (var h = 0; h < HAVUZ_KELIMELER.length; h++) {\n          var hk = (HAVUZ_KELIMELER[h].kelime || \"\").toLowerCase().trim();\n          if (aktarilanIsimler.map(function(x){ return x.toLowerCase().trim(); }).indexOf(hk) !== -1) {\n            HAVUZ_KELIMELER[h].aktarildi = true;\n            HAVUZ_KELIMELER[h].durum = \"Aktarıldı\";\n          }\n        }\n\n        HAVUZ_AKTARILIYOR = false;\n        listeyiBirlestirVeHazirla(SHEET_KELIMELER.length ? SHEET_KELIMELER : FALLBACK_WORDS, false);\n        bildirimGoster(\"✅ Transferred \" + zenginKelimeler.length + \" word(s) to Words!\");\n\n        if (APPS_SCRIPT_URL) {\n          document.getElementById(\"syncDot\").className = \"sync-dot loading\";\n          document.getElementById(\"syncText\").innerText = \"Saving...\";\n          fetch(APPS_SCRIPT_URL, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"text/plain;charset=utf-8\" },\n            body: JSON.stringify({ action: \"addWords\", words: zenginKelimeler })\n          })\n            .then(function(r) { return r.json(); })\n            .then(function(res) {\n              if (res && res.ok) {\n                bildirimGoster(\"☁️ Saved to Google Sheets 'Words' tab (\" + zenginKelimeler.length + \" words)\");\n                appsScripttenYukle();\n              } else {\n                document.getElementById(\"syncDot\").className = \"sync-dot\";\n                document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n              }\n            })\n            .catch(function() {\n              document.getElementById(\"syncDot\").className = \"sync-dot\";\n              document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n            });\n        }\n      }).catch(function() {\n        HAVUZ_AKTARILIYOR = false;\n        havuzSecimButonunuGuncelle();\n      });\n    }\n\n    function havuzdanTekKelimeAktar(kelime, seviye) {\n      havuzdanKelimeListesiAktar([{ kelime: kelime, seviye: seviye || \"B2\" }]);\n    }\n\n    function havuzSecilenleriAktar() {\n      var secilenObjeler = [];\n      for (var i = 0; i < HAVUZ_KELIMELER.length; i++) {\n        var h = HAVUZ_KELIMELER[i];\n        var hk = (h.kelime || \"\").toLowerCase().trim();\n        if (hk && HAVUZ_SECILENLER[hk]) {\n          secilenObjeler.push({ kelime: h.kelime, seviye: h.seviye });\n        }\n      }\n      if (secilenObjeler.length === 0) {\n        bildirimGoster(\"ℹ️ Please select words to transfer first.\");\n        return;\n      }\n      havuzdanKelimeListesiAktar(secilenObjeler);\n    }\n\n    function havuzdanRastgeleAktar() {\n      var adetEl = document.getElementById(\"havuzRandomCount\");\n      var adet = adetEl ? parseInt(adetEl.value, 10) : 5;\n      if (isNaN(adet) || adet < 1) adet = 5;\n      if (adet > 50) adet = 50;\n\n      var aktifLvl = (document.getElementById(\"levelFilter\") ? document.getElementById(\"levelFilter\").value : \"ALL\");\n      var wordsMap = {};\n      for (var i = 0; i < TUM_KELIMELER.length; i++) {\n        var wk = (TUM_KELIMELER[i].kelime || \"\").toLowerCase().trim();\n        if (wk) wordsMap[wk] = true;\n      }\n      var yerelMap = havuzYerelAktarilanAl();\n\n      var bekleyenler = [];\n      for (var j = 0; j < HAVUZ_KELIMELER.length; j++) {\n        var h = HAVUZ_KELIMELER[j];\n        if (aktifLvl !== \"ALL\" && h.seviye !== aktifLvl) continue;\n        if (!havuzKelimeAktarildiMi(h, wordsMap, yerelMap)) {\n          bekleyenler.push({ kelime: h.kelime, seviye: h.seviye });\n        }\n      }\n\n      if (bekleyenler.length === 0) {\n        bildirimGoster(\"ℹ️ No waiting words left in the selected level.\");\n        return;\n      }\n\n      // Karıştır ve N tanesini seç\n      for (var m = bekleyenler.length - 1; m > 0; m--) {\n        var r = Math.floor(Math.random() * (m + 1));\n        var tmp = bekleyenler[m];\n        bekleyenler[m] = bekleyenler[r];\n        bekleyenler[r] = tmp;\n      }\n\n      var secilenler = bekleyenler.slice(0, adet);\n      havuzdanKelimeListesiAktar(secilenler);\n    }\n\n    function durumKutusuHtml(row, durum) {\n      return (\n        '<div class=\"mark-split ' + (durum || \"beklemede\") + '\">' +\n          '<button type=\"button\" class=\"mark-half mark-top\" aria-label=\"Mark as known\" onclick=\"durumSec(event, ' + row + ', \\'biliyorum\\')\" title=\"Top (✓): Known\">✓</button>' +\n          '<button type=\"button\" class=\"mark-half mark-bot\" aria-label=\"Mark as unknown\" onclick=\"durumSec(event, ' + row + ', \\'bilmiyorum\\')\" title=\"Bottom (✕): Unknown\">✕</button>' +\n        '</div>'\n      );\n    }\n\n    function durumSec(e, row, tip) {\n      if (e) {\n        e.preventDefault();\n        e.stopPropagation();\n      }\n      kutucukDegisti(row, tip, true, true);\n    }\n\n    function kutucukDegisti(row, tip, isChecked, manuelMi) {\n      var hedef = null;\n      for (var i = 0; i < TUM_KELIMELER.length; i++) {\n        if (TUM_KELIMELER[i].row === row) { hedef = TUM_KELIMELER[i]; break; }\n      }\n      if (!hedef) return;\n      var yeniDurum = isChecked ? tip : \"beklemede\";\n      var key = (hedef.kelime || \"\").toString().trim().toLowerCase();\n      SON_YEREL_DEGISIM[key] = Date.now();\n      hedef.durum = yeniDurum;\n      hedef.biliyorum = yeniDurum === \"biliyorum\";\n      hedef.bilmiyorum = yeniDurum === \"bilmiyorum\";\n      for (var s = 0; s < SHEET_KELIMELER.length; s++) {\n        if (SHEET_KELIMELER[s].row === row || (SHEET_KELIMELER[s].kelime || \"\").toLowerCase() === key) {\n          SHEET_KELIMELER[s].durum = yeniDurum;\n          SHEET_KELIMELER[s].biliyorum = yeniDurum === \"biliyorum\";\n          SHEET_KELIMELER[s].bilmiyorum = yeniDurum === \"bilmiyorum\";\n        }\n      }\n      if (key) {\n        var ist = istatistikMapAl();\n        if (manuelMi !== false && yeniDurum === \"biliyorum\") {\n          var stKayit = istatistikKaydiNormalizeEt(ist[key]);\n          stKayit.word = hedef.kelime;\n          stKayit.manualKnown = true;\n          stKayit.autoMasteredByStreak = false;\n          ist[key] = stKayit;\n          istatistikMapKaydet(ist);\n        } else if (yeniDurum === \"bilmiyorum\" && ist[key]) {\n          var stKayit2 = istatistikKaydiNormalizeEt(ist[key]);\n          stKayit2.manualKnown = false;\n          stKayit2.autoMasteredByStreak = false;\n          ist[key] = stKayit2;\n          istatistikMapKaydet(ist);\n        }\n      }\n      kisiselDurumKaydet(hedef.kelime, yeniDurum);\n      kisiselKnownSiraGuncelle(hedef.kelime, yeniDurum);\n      tabloyuCiz();\n      var durumEtiket = yeniDurum === \"biliyorum\" ? \"✓ Known (Moved to bottom)\" : (yeniDurum === \"bilmiyorum\" ? \"✕ Unknown\" : \"○ Pending\");\n      bildirimGoster(durumEtiket + \": \" + hedef.kelime);\n\n      if (APPS_SCRIPT_URL) {\n        document.getElementById(\"syncDot\").className = \"sync-dot loading\";\n        document.getElementById(\"syncText\").innerText = \"Saving...\";\n        fetch(APPS_SCRIPT_URL, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"text/plain;charset=utf-8\" },\n          body: JSON.stringify({ action: \"setStatus\", row: hedef.row, status: yeniDurum })\n        })\n          .then(function(r) { return r.json(); })\n          .then(function(res) {\n            document.getElementById(\"syncDot\").className = \"sync-dot\";\n            document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n            if (res && res.ok) {\n              bildirimGoster(durumEtiket + \" saved: \" + hedef.kelime);\n            }\n          })\n          .catch(function() {\n            document.getElementById(\"syncDot\").className = \"sync-dot\";\n            document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n          });\n      }\n    }\n\n    function ekleBarAcKapat() {\n      var isOpen = document.getElementById(\"addBar\").classList.toggle(\"open\");\n      document.getElementById(\"addWordToggleBtn\").setAttribute(\"aria-expanded\", String(isOpen));\n      if (isOpen) document.getElementById(\"inKelime\").focus();\n      tercihleriKaydet();\n    }\n\n    function yeniKelimeKaydet() {\n      var kelime = document.getElementById(\"inKelime\").value.trim();\n      var anlam = document.getElementById(\"inAnlam\").value.trim();\n      if (!kelime || !anlam) { bildirimGoster(\"Word and Meaning are required.\"); return; }\n\n      var today = new Date().toISOString().slice(0, 10);\n      var yeni = {\n        tarih: today,\n        kelime: kelime,\n        okunus: \"\",\n        tur: document.getElementById(\"inTur\").value,\n        seviye: document.getElementById(\"inSeviye\").value,\n        anlam: anlam,\n        ornek: document.getElementById(\"inOrnek\").value.trim(),\n        durum: \"bilmiyorum\"\n      };\n\n      var eklenenler = kisiselEklenenleriAl();\n      eklenenler.push(yeni);\n      kisiselEklenenKaydet(eklenenler);\n      kisiselDurumKaydet(kelime, \"bilmiyorum\");\n      SON_YEREL_DEGISIM[kelime.toLowerCase()] = Date.now();\n\n      document.getElementById(\"inKelime\").value = \"\";\n      document.getElementById(\"inAnlam\").value = \"\";\n      document.getElementById(\"inOrnek\").value = \"\";\n\n      listeyiBirlestirVeHazirla(SHEET_KELIMELER.length ? SHEET_KELIMELER : FALLBACK_WORDS, false);\n      bildirimGoster(\"☁️ Adding to Google Sheet: \" + kelime + \"...\");\n\n      if (APPS_SCRIPT_URL) {\n        var btn = document.getElementById(\"saveWordBtn\");\n        if (btn) btn.disabled = true;\n        document.getElementById(\"syncDot\").className = \"sync-dot loading\";\n        document.getElementById(\"syncText\").innerText = \"Saving...\";\n        fetch(APPS_SCRIPT_URL, {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"text/plain;charset=utf-8\" },\n          body: JSON.stringify({ action: \"addWords\", words: [yeni] })\n        })\n          .then(function(r) { return r.json(); })\n          .then(function(res) {\n            if (btn) btn.disabled = false;\n            if (res && res.ok) {\n              bildirimGoster(\"✅ Added to Google Sheet: \" + kelime);\n              appsScripttenYukle();\n            } else {\n              document.getElementById(\"syncDot\").className = \"sync-dot\";\n              document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n            }\n          })\n          .catch(function() {\n            if (btn) btn.disabled = false;\n            document.getElementById(\"syncDot\").className = \"sync-dot\";\n            document.getElementById(\"syncText\").innerText = \"Live (\" + TUM_KELIMELER.length + \")\";\n          });\n      }\n    }\n\n\n    /** Update the workspace from the same word counts used by the library. */\n    function updateWorkspaceOverview(total, learning, mastered) {\n      var percent = total ? Math.round(mastered / total * 100) : 0;\n      document.getElementById(\"masteryPercent\").innerHTML = percent + \"<span>%</span>\";\n      document.getElementById(\"masteryFill\").style.width = percent + \"%\";\n      document.getElementById(\"masteryProgress\").setAttribute(\"aria-valuenow\", percent);\n      document.getElementById(\"masteryCaption\").textContent = mastered + \" of \" + total + \" words mastered\";\n      document.getElementById(\"practiceDescription\").textContent = learning ? learning + \" words to work on. Pick up where you left off.\" : \"Explore your collection or add a new word to practice.\";\n      updateWorkspaceHeading();\n    }\n\n    /** Keep page context and navigation accessible across library and study views. */\n    function updateWorkspaceHeading() {\n      document.querySelector(\".workspace-panel\").classList.toggle(\"words-panel\", AKTIF_SEKME === \"sheet1\");\n      var views = {\n        sheet1: [\"My vocabulary\", \"A home for the words you’re learning. Make each one stick.\", \"Your word collection\", \"Words\"],\n        sheetHavuz: [\"Word pool\", \"Discover your next words and add them to your collection.\", \"Words to explore\", \"Word pool\"],\n        pool: [\"Still learning\", \"Give these words a little more time and practice.\", \"Words in progress\", \"Still learning\"],\n        knownPool: [\"Words mastered\", \"The words you’ve made your own. Revisit them anytime.\", \"Your mastered words\", \"Mastered\"],\n        stats: [\"Your statistics\", \"Follow your practice, accuracy, and progress over time.\", \"Practice insights\", \"Statistics\"]\n      };\n      var modes = {flashcards:\"Flashcards\", cloze:\"Fill in the blank\", quiz:\"Quiz\", confusables:\"Similar words\", listen:\"Listening\", match:\"Word match\"};\n      var view = views[AKTIF_SEKME] || [modes[AKTIF_MOD] || \"Practice\", \"A little focus. A few words. Keep your learning moving.\", \"Your practice session\", \"Practice\"];\n      [\"workspaceTitle\", \"workspaceDescription\", \"collectionTitle\", \"breadcrumbLabel\"].forEach(function(id, index) { document.getElementById(id).textContent = view[index]; });\n      document.querySelectorAll(\".side-nav-btn\").forEach(function(button) {\n        if (button.classList.contains(\"active-mode\")) button.setAttribute(\"aria-current\", \"page\");\n        else button.removeAttribute(\"aria-current\");\n      });\n      document.querySelector(\".practice-banner\").hidden = AKTIF_SEKME === \"flashcards\";\n      document.querySelector(\".overview-grid\").hidden = AKTIF_SEKME === \"flashcards\";\n    }\n\n    /** Show the number of matching rows rather than the unfiltered collection size. */\n    function updateVisibleResultCount() {\n      var bodies = {sheet1:\"sheet1Body\", sheetHavuz:\"sheetHavuzBody\", pool:\"poolBody\", knownPool:\"knownPoolBody\", stats:\"statsBody\"};\n      var body = document.getElementById(bodies[AKTIF_SEKME]);\n      var count = body ? body.querySelectorAll(\"tr > td:first-child:not([colspan])\").length : 0;\n      var result = document.getElementById(\"resultCount\");\n      result.hidden = !body;\n      result.textContent = count + (AKTIF_SEKME === \"stats\" ? (count === 1 ? \" record\" : \" records\") : (count === 1 ? \" word\" : \" words\"));\n    }\n\n    /** Clear both library filters and persist the updated preference. */\n    function clearVocabularyFilters() {\n      document.getElementById(\"searchInput\").value = \"\";\n      document.getElementById(\"levelFilter\").value = \"ALL\";\n      tercihleriKaydet();\n      tabloyuCiz();\n    }\n\n    document.addEventListener(\"keydown\", function(event) {\n      var isEditing = /^(INPUT|SELECT|TEXTAREA)$/.test(event.target.tagName) || event.target.isContentEditable;\n      if (event.key === \"/\" && !isEditing) { event.preventDefault(); document.getElementById(\"searchInput\").focus(); }\n      if (event.key === \"Escape\") { mobilMenuKapat(); document.getElementById(\"settingsMenu\").open = false; }\n    });\n\n    document.addEventListener(\"click\", function(event) {\n      var settings = document.getElementById(\"settingsMenu\");\n      if (!settings.contains(event.target)) settings.open = false;\n    });\n\n    // Restore all saved button/tab/filter preferences, then render and live sync from Google Sheet\n    syncMobileNavigation();\n    window.matchMedia(\"(max-width: 820px)\").addEventListener(\"change\", mobilMenuKapat);\n    tercihleriYukleVeUygula();\n    var onbellekHavuz = yerelOnbellekAl(\"kelime_son_havuz_v1\");\n    if (onbellekHavuz) {\n      HAVUZ_KELIMELER = onbellekHavuz;\n    }\n    var onbellekWords = yerelOnbellekAl(\"kelime_son_sheet_words_v1\");\n    if (onbellekWords) {\n      SHEET_KELIMELER = onbellekWords;\n      listeyiBirlestirVeHazirla(SHEET_KELIMELER, false);\n    } else {\n      listeyiBirlestirVeHazirla(FALLBACK_WORDS, false);\n    }\n    verileriYukle(false);\n\n    window.addEventListener(\"storage\", function(e) {\n      if (e && e.key === \"kelime_istatistik_v1\") {\n        istatistikTablosuCiz();\n      }\n    });\n    setInterval(function() {\n      if (AKTIF_SEKME === \"stats\") {\n        istatistikTablosuCiz();\n      }\n    }, 3000);\n  </script>\n</body>\n</html>\n";
}
