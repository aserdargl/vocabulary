       for (var n = 0; n < candidate.length; n++) {\n            var hk = (candidate[n] || \"\").toLowerCase().trim();\n            if (hk === \"level\" || hk === \"seviye\") map.level = n;\n            else if (hk === \"word\" || hk === \"kelime\") map.word = n;\n            else if (hk === \"status\" || hk === \"durum\") map.status = n;\n            else if (hk.indexOf(\"transfer\") !== -1 || hk.indexOf(\"aktar\") !== -1) map.transferred = n;\n          }\n          break;\n        }\n      }\n\n      var parsed = [];\n      for (var p = startIdx; p < allRows.length; p++) {\n        var dRow = allRows[p];\n        var w = (dRow[map.word] || \"\").trim();\n        if (!w || w.toLowerCase() === \"word\" || w.toLowerCase() === \"kelime\") continue;\n        var stText = (dRow[map.status] || \"\").trim();\n        var trVal = (dRow[map.transferred] || \"\").toUpperCase().trim();\n        var aktarildi = (trVal === \"TRUE\") || (stText.toLowerCase().indexOf(\"aktar\") !== -1);\n        parsed.push({\n          row: parsed.length + 2,\n          seviye: (dRow[map.level] || \"B1\").toUpperCase().trim(),\n          kelime: w,\n          durum: aktarildi ? \"Aktarıldı\" : (stText || \"Bekliyor\"),\n          aktarildi: aktarildi\n        });\n      }\n      return parsed;\n    }\n\n    function yerelOnbellekKaydet(anahtar, veri) {\n      try {\n        localStorage.setItem(anahtar, JSON.stringify(veri));\n      } catch (e) {}\n    }\n\n    function yerelOnbellekAl(anahtar) {\n      try {\n        var raw = localStorage.getItem(anahtar);\n        if (!raw) return null;\n        var parsed = JSON.parse(raw);\n        return Array.isArray(parsed) && parsed.length > 0 ? parsed : null;\n      } catch (e) {\n        return null;\n      }\n    }\n\n    window.__onSheetData = function(response) {\n      try {\n        if (response && response.table) {\n          var liste = gvizTablosunuCozumle(response.table);\n          if (liste && liste.length > 0) {\n            SHEET_KELIMEL